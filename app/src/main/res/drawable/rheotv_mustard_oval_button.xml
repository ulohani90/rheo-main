<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="false">
        <layer-list>
            <item android:left="4dp" android:top="4dp">
                <shape>
                    <solid android:color="#66000000" />
                    <corners android:radius="32dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape>
                    <gradient android:angle="90" android:endColor="@color/colorBackgroundItems" android:startColor="@color/colorBackgroundItems" />
                    <corners android:radius="32dp" />
                    <stroke android:width="0px" android:color="@color/colorBackgroundItems" />
                </shape>
            </item>
        </layer-list>

    </item>

    <item android:state_pressed="true">
        <layer-list>
            <item android:bottom="2dp">
                <shape>
                    <gradient android:angle="90" android:endColor="@color/colorBackgroundItems" android:startColor="@color/colorBackgroundItems" />
                    <corners android:radius="32dp" />
                    <stroke android:width="0px" android:color="@color/colorBackgroundItems" />
                </shape>
            </item>
        </layer-list>

    </item>
</selector>