<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.rheotv.android.ui.activities.tabcontainer.posts.PostItemViewModel" />

        <import type="android.view.View" />
    </data>


    <RelativeLayout
        android:id="@+id/carousel_item_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background_color">

        <View
            android:id="@+id/margin_view"
            android:layout_width="@dimen/margin_12"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@id/margin_view">

            <TextView
                android:id="@+id/live_tag_old"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:background="@drawable/button_transparent_white_border"
                android:elevation="2dp"
                android:paddingLeft="4dp"
                android:paddingTop="2dp"
                android:paddingRight="4dp"
                android:paddingBottom="2dp"
                android:text="LIVE"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_margin="@dimen/margin_8"
                android:background="@drawable/round_background_black"
                android:elevation="10dp"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/margin_4"
                android:paddingRight="@dimen/margin_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_min="40dp">

                <ImageView
                    android:id="@+id/listing_iv_views"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="@dimen/margin_4"
                    android:src="@drawable/eye_white" />

                <TextView
                    android:id="@+id/listing_tv_noofviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:layout_marginEnd="@dimen/margin_2"
                    tools:text="111"/>

            </LinearLayout>

            <FrameLayout
                android:id="@+id/media_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@id/streamer_info_layout">

                <com.makeramen.roundedimageview.RoundedImageView
                    android:id="@+id/imageView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:riv_corner_radius="@dimen/corner_radius" />


                <com.rheotv.android.ui.customViews.RoundedFrameLayout
                    android:id="@+id/media_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="@dimen/margin_2" />


            </FrameLayout>

            <include
                android:id="@+id/more_options_layout"
                layout="@layout/more_options_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignBottom="@id/media_layout"
                android:visibility="gone" />


            <LinearLayout
                android:id="@+id/streamer_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="horizontal"
                android:paddingTop="@dimen/margin_12">

                <com.rheotv.android.ui.customViews.CircularImageView
                    android:id="@+id/author_profile_pic"
                    android:layout_width="@dimen/margin_36"
                    android:layout_height="@dimen/margin_36"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:scaleType="centerCrop"
                    app:civ_border="true"
                    app:civ_border_color="@color/white"
                    app:civ_border_width="@dimen/margin_1" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/author_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#fbfbfb"
                        android:textSize="16sp"
                        android:textStyle="normal"
                        tools:text="Dreamleague" />

                    <TextView
                        android:id="@+id/title_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textColor="@color/light_grey_text_color"
                        android:textSize="13sp"
                        android:textStyle="normal"
                        tools:text="Happy holiday giveaways. Let's play... " />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <TextView
                        android:id="@+id/author_game"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_2"
                        android:background="@drawable/game_tag_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/margin_8"
                        android:paddingTop="@dimen/margin_2"
                        android:paddingEnd="@dimen/margin_8"
                        android:paddingBottom="@dimen/margin_2"
                        android:textColor="@color/white_text_color"
                        android:textSize="12sp"
                        android:textStyle="normal"
                        tools:text="Fortnite Chapter 2" />

                        <TextView
                            android:id="@+id/language_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/game_tag_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginTop="@dimen/margin_2"
                            android:layout_marginStart="@dimen/margin_8"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="@dimen/margin_8"
                            android:paddingTop="@dimen/margin_2"
                            android:paddingEnd="@dimen/margin_8"
                            android:paddingBottom="@dimen/margin_2"
                            android:textColor="@color/white_text_color"
                            android:textSize="12sp"
                            android:textStyle="normal"
                            android:layout_gravity="center_vertical"
                            tools:text="English" />

                    </LinearLayout>

                </LinearLayout>

                <ImageView
                    android:id="@+id/more_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_8"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_more_vert_white_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/media_load_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/color_accent"
                android:layout_alignTop="@id/media_layout"
                android:layout_alignBottom="@id/media_layout"
                android:layout_centerHorizontal="true"
                android:visibility="gone" />

            <!--<androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/author_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:background="@drawable/carousel_title"
                android:paddingLeft="@dimen/margin_8"
                android:paddingRight="@dimen/margin_8"
                android:paddingBottom="@dimen/margin_8"
                android:visibility="gone">

                <com.rheotv.android.ui.customViews.CircularImageView
                    android:id="@+id/postUserProfile"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:visibility="visible"
                    app:civ_border_width="0dp"
                    app:civ_shadow="false"
                    app:civ_shadow_gravity="center"
                    app:civ_shadow_radius="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/postUserProfile"
                    tools:background="@drawable/avd_avatar" />

                &lt;!&ndash;<ImageView
                    android:id="@+id/more_options"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_more_vert_white_32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />&ndash;&gt;

                <androidx.emoji.widget.EmojiTextView
                    android:id="@+id/user_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/postUserProfile"
                    app:layout_constraintTop_toTopOf="@id/postUserProfile"
                    tools:text="hello world" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >

                <TextView
                    android:id="@+id/watchNowTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_8"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ONE MAN SQUAD"
                    android:textColor="@color/light_dull"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/postUserProfile"
                    app:layout_constraintTop_toBottomOf="@id/user_name_tv" />


                    <TextView
                        android:id="@+id/language_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/game_tag_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginTop="@dimen/margin_2"
                        android:layout_marginStart="@dimen/margin_8"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/margin_8"
                        android:paddingTop="@dimen/margin_2"
                        android:paddingEnd="@dimen/margin_8"
                        android:paddingBottom="@dimen/margin_2"
                        android:textColor="@color/white_text_color"
                        android:textSize="12sp"
                        android:textStyle="normal"
                        android:layout_gravity="center_vertical"
                        tools:text="English" />

                </LinearLayout>

            </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>-->


            <TextView
                android:id="@+id/carouselTextView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/media_layout"
                android:value="Hello world"
                android:visibility="gone" />

            <RelativeLayout
                android:id="@+id/live_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/media_layout"
                android:background="@drawable/carousel_title"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:paddingLeft="@dimen/margin_12"
                android:paddingTop="@dimen/margin_6"
                android:paddingRight="@dimen/margin_12"
                android:paddingBottom="@dimen/margin_6"
                android:visibility="gone">

                <!--<ImageView
                    android:id="@+id/more_options_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_more_vert_white_32dp" />-->

                <View
                    android:id="@+id/live_icon_circle_1"
                    android:layout_width="@dimen/margin_12"
                    android:layout_height="@dimen/margin_12"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:background="@drawable/red_circle_border_bg" />

                <View
                    android:id="@+id/live_icon_circle_2"
                    android:layout_width="@dimen/margin_12"
                    android:layout_height="@dimen/margin_12"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_8"
                    android:background="@drawable/red_circle_border_bg" />

                <View
                    android:id="@+id/live_icon_dot"
                    android:layout_width="@dimen/margin_12"
                    android:layout_height="@dimen/margin_12"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:background="@drawable/red_dot_bg"
                    android:visibility="visible" />

                <TextView
                    android:id="@+id/live_now_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/live_icon_dot"
                    android:text="LIVE NOW"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="visible" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/live_now_text"
                    android:layout_toEndOf="@id/live_icon_dot"
                    android:text="Click to chat"
                    android:textColor="#aeaeb2"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/volume_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:elevation="8dp"
                    android:padding="4dp"
                    android:src="@drawable/volume_state_selector"
                    android:visibility="visible" />

            </RelativeLayout>


        </RelativeLayout>

    </RelativeLayout>
</layout>