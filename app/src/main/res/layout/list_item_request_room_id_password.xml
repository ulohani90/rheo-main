<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="playerCount"
            type="String" />

        <variable
            name="coinValue"
            type="String" />

        <variable
            name="startTime"
            type="String" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/margin_12"
        android:paddingBottom="@dimen/margin_8">

        <TextView
            android:id="@+id/player_count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Players"
            android:textColor="#aeaeb2"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@+id/coins_count_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/player_count_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@{playerCount}"
            android:textColor="#fbfbfb"
            android:textSize="@dimen/text_15"
            app:layout_constraintEnd_toEndOf="@+id/player_count_label"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/player_count_label"
            app:layout_constraintTop_toBottomOf="@+id/player_count_label"
            tools:text="40" />

        <TextView
            android:id="@+id/coins_count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coins"
            android:textColor="#aeaeb2"
            android:textSize="@dimen/text_13"
            app:layout_constraintEnd_toStartOf="@+id/start_time_label"
            app:layout_constraintStart_toEndOf="@+id/player_count_label"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/start_time_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@{startTime}"
            android:textColor="#fbfbfb"
            android:textSize="@dimen/text_15"
            app:layout_constraintEnd_toEndOf="@+id/start_time_label"
            app:layout_constraintStart_toStartOf="@+id/start_time_label"
            app:layout_constraintTop_toBottomOf="@+id/start_time_label"
            tools:text="11:40 AM" />

        <ImageView
            android:id="@+id/time_picker"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="@dimen/margin_4"
            android:padding="7dp"
            android:src="@drawable/ic_edit_white_24dp"
            app:layout_constraintBottom_toBottomOf="@+id/start_time_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@+id/start_time_text_view"
            app:layout_constraintTop_toTopOf="@+id/start_time_text_view" />

        <TextView
            android:id="@+id/coins_count_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@{coinValue}"
            android:textColor="#fbfbfb"
            android:textSize="@dimen/text_15"
            app:layout_constraintEnd_toEndOf="@+id/coins_count_label"
            app:layout_constraintStart_toStartOf="@+id/coins_count_label"
            app:layout_constraintTop_toBottomOf="@+id/coins_count_label"
            tools:text="40" />

        <TextView
            android:id="@+id/start_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starts At"
            android:textColor="#aeaeb2"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/coins_count_label"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/room_id_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_12"
            android:fontFamily="sans-serif"
            android:text="Room ID"
            android:textColor="#aeaeb2"
            android:textSize="@dimen/text_13"
            app:layout_constraintBottom_toBottomOf="@+id/room_id_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/room_id_input" />

        <TextView
            android:id="@+id/password_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_12"
            android:fontFamily="sans-serif"
            android:text="Password"
            android:textColor="#aeaeb2"
            android:textSize="@dimen/text_13"
            app:layout_constraintBottom_toBottomOf="@+id/room_password_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/room_password_input" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/input_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:barrierDirection="end"
            app:constraint_referenced_ids="room_id_label,password_label" />

        <EditText
            android:id="@+id/room_id_input"
            style="@style/EditTextStyle.Base"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_12"
            android:layout_marginEnd="@dimen/margin_16"
            android:hint="Enter Room Id"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/input_barrier"
            app:layout_constraintTop_toBottomOf="@+id/player_count_text_view" />


        <EditText
            android:id="@+id/room_password_input"
            style="@style/EditTextStyle.Base"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_6"
            android:layout_marginEnd="@dimen/margin_16"
            android:hint="Enter Room Password"
            android:inputType="textPassword"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/input_barrier"
            app:layout_constraintTop_toBottomOf="@+id/room_id_input" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/submit_button"
            style="@style/BaseButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/margin_32"
            android:layout_marginTop="@dimen/margin_8"
            android:backgroundTint="@color/color_accent"
            android:fontFamily="sans-serif-medium"
            android:text="@string/submit"
            android:textSize="15sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/room_password_input" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>