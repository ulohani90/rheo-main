                    android:text="@{viewModel.authorProfileData.progressData.label1 + ` ` + viewModel.authorProfileData.progressData.progress + `%`}"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_17"
                    android:visibility="@{viewModel.authorProfileData.shouldShowPorgress ? View.VISIBLE : View.GONE}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/containerLayout" />


                <TextView
                    android:id="@+id/label2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_10"
                    android:fontFamily="@font/raleway_medium"
