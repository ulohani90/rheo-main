<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/notification_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="false"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        >

        <TextView
            android:id="@+id/content_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:textSize="16sp"
            android:paddingRight="4dp"
            android:layout_marginRight="4dp"
            android:text="Notification Sample App"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>

        <TextView
            android:id="@+id/content_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black_dark"
            android:text="Expand me to see a detailed message!"
            android:textAppearance="@style/TextAppearance.Compat.Notification"/>

    </LinearLayout>
    <RelativeLayout
        android:id="@+id/icon_container"
        android:layout_below="@id/notification_main"
        android:layout_above="@id/mojo_times_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/big_icon"
            android:layout_width="match_parent"
            android:padding="2dp"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/ic_app_logo_transparent_bg_42"/>

        <ImageView
            android:id="@+id/video_play_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:alpha="0.5"
            android:gravity="center_vertical"
            android:src="@drawable/video_play_icon" />

    </RelativeLayout>
    <ImageView
        android:id="@+id/mojo_times_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentRight="true"
        android:visibility="gone"
        android:layout_margin="2dp"
        android:gravity="center_vertical"
        android:src="@drawable/ic_app_logo_transparent_bg_42" />
</RelativeLayout>