<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.activities.share.ShareVideoFragment">

    <data>

        <variable
            name="videoUrl"
            type="String" />

        <variable
            name="thumbnail"
            type="String" />

        <variable
            name="viewModel"
            type="com.rheotv.android.ui.activities.share.ShareViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/margin_8"
            app:cardBackgroundColor="#1d2e44"
            app:cardCornerRadius="@dimen/size_12"
            app:cardElevation="@dimen/size_6">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/backdrop_image_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:blurFactor="@{5}"
                    app:blurImageUri="@{viewModel.backdrop}"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.exoplayer2.ui.PlayerView
                    android:id="@+id/video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:controlView="@{imageViewPlay}"
                    app:mediaUrl="@{videoUrl}"
                    app:play="@{false}"
                    app:progressView="@{viewProgress}" />

                <ImageView
                    android:id="@+id/image_view_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/margin_16"
                    android:src="@drawable/avd_play"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="1" />

                <TextView
                    android:id="@+id/text_view_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingEnd="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_8"
                    android:text="30 s"
                    android:textColor="@color/white_text_color"
                    android:textSize="@dimen/text_13"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/image_view_play"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@id/image_view_play"
                    app:layout_constraintTop_toTopOf="@+id/image_view_play" />

                <ProgressBar
                    android:id="@+id/view_progress"
                    android:layout_width="@dimen/size_32"
                    android:layout_height="@dimen/size_32"
                    android:visibility="gone"
                    android:indeterminateTint="@color/color_accent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>