<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/bioText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_12"
                android:paddingTop="@dimen/margin_12"
                android:paddingBottom="@dimen/margin_16"
                android:text="Hello, this is my bio"
                android:textColor="@color/white_dull"
                android:textSize="@dimen/text_17"
                app:layout_goneMarginTop="@dimen/margin_16"
                tools:text="Hi" />


            <LinearLayout
                android:id="@+id/chatboxLL"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_12"
                android:layout_marginBottom="@dimen/margin_12"
                android:background="@drawable/bio_edit_text_background"
                android:orientation="horizontal"
                android:paddingStart="@dimen/margin_4"
                android:paddingTop="@dimen/margin_12"
                android:paddingEnd="@dimen/margin_4"
                android:paddingBottom="@dimen/margin_12"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">


                <androidx.emoji.widget.EmojiEditText
                    android:id="@+id/editBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_6"
                    android:layout_marginEnd="@dimen/margin_4"
                    android:background="@color/transparent"
                    android:gravity="top"
                    android:hint="Please add your bio here"
                    android:minHeight="124dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/white_dull"
                    android:textSize="@dimen/text_15" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/followButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="@dimen/margin_12"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginRight="@dimen/margin_12"
                android:background="@drawable/rheotv_mustard_oval_button"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/followTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="2dp"
                    android:text="Submit"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/editButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="@dimen/margin_12"
                android:layout_marginTop="@dimen/margin_12"
                android:layout_marginRight="@dimen/margin_12"
                android:background="@drawable/rheotv_mustard_oval_button"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingTop="4dp"
                android:paddingRight="16dp"
                android:paddingBottom="4dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/editTextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="2dp"
                    android:text="Edit"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>