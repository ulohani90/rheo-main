<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_16">

        <View
            android:id="@+id/avatar_1"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/circular_follow_btn_normal"
            android:backgroundTint="@color/player_unplayed_color"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <View
            android:id="@+id/user_name_placeholder"
            android:layout_width="60dp"
            android:layout_height="@dimen/margin_8"
            android:layout_marginStart="@dimen/margin_6"
            android:background="@color/player_unplayed_color"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_1"
            app:layout_constraintStart_toEndOf="@+id/avatar_1"
            app:layout_constraintTop_toTopOf="@+id/avatar_1" />

        <View
            android:id="@+id/message_placeholder"
            android:layout_width="200dp"
            android:layout_height="@dimen/margin_8"
            android:layout_marginStart="@dimen/margin_16"
            android:background="@color/player_unplayed_color"
            app:layout_constraintBottom_toBottomOf="@+id/avatar_1"
            app:layout_constraintStart_toEndOf="@+id/user_name_placeholder"
            app:layout_constraintTop_toTopOf="@+id/avatar_1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>