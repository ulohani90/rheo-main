<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="game"
            type="com.rheotv.android.data.network.models.gamify.CodaShopGame" />

    </data>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/thumbnail_image_view"
            android:layout_width="@dimen/size_48"
            android:layout_height="@dimen/size_48"
            android:layout_margin="@dimen/margin_4"
            android:elevation="2dp"
            android:scaleType="fitXY"
            app:imageUrl="@{game.thumbnail}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="@dimen/corner_radius"
            tools:src="@drawable/poster_splash" />

        <TextView
            android:id="@+id/title_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_10"
            android:fontFamily="sans-serif"
            android:text="@{game.name}"
            android:textColor="@color/white_text_color"
            android:textSize="@dimen/text_15"
            android:textStyle="normal"
            app:layout_constraintBottom_toTopOf="@id/helper_text_view"
            app:layout_constraintEnd_toStartOf="@id/next_action_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/thumbnail_image_view"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="PUBG" />

        <TextView
            android:id="@+id/helper_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text='@{(@string/redeem_message).replace("$game", game.name).replace("$product", game.codaShopInterface)}'
            android:textColor="@color/light_grey_text_color"
            android:textSize="@dimen/text_12"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/next_action_button"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/title_text_view"
            app:layout_constraintTop_toBottomOf="@id/title_text_view"
            tools:text="Redeem your Rheo points for FREE FIRE DIAMONDS" />

        <ImageButton
            android:id="@+id/next_action_button"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="@dimen/margin_32"
            android:layout_height="@dimen/margin_32"
            android:background="@drawable/ic_keyboard_arrow_down_white"
            android:clickable="false"
            android:padding="@dimen/margin_8"
            android:rotation="270"
            android:visibility="@{(game.codaShopProductName == null || game.codaShopProductName.isEmpty()) ? View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider_view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_8"
            android:background="#32425c"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/thumbnail_image_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>