<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.rheotv.android.ui.activities.tabcontainer.posts.TagItemViewModel" />

    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/news_tv_origin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_4"
            android:background="@drawable/tags_bck_view"
            android:gravity="center"
            android:paddingStart="@dimen/margin_4"
            android:paddingTop="@dimen/margin_2"
            android:paddingEnd="@dimen/margin_4"
            android:paddingBottom="@dimen/margin_2"
            android:text="@{viewModel.origin}"
            android:textColor="@color/white"
            android:textSize="@dimen/text_10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/videoThumbnail" />

    </LinearLayout>


</layout>


