<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.rheotv.android.ui.activities.player.activity.ChatViewModel" />

    </data>

    <FrameLayout
        android:id="@+id/frame_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/userChatRV"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginEnd="@dimen/margin_12"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layoutAnimation="@anim/chat_item_animation"
                    android:paddingTop="@dimen/margin_4"
                    android:scrollbars="none"
                    app:layout_constraintBottom_toTopOf="@id/chatboxLL"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:listitem="@layout/chat_item_v2" />

                <LinearLayout
                    android:id="@+id/unread_comment_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_marginEnd="@dimen/margin_24"
                    android:layout_marginBottom="@dimen/margin_24"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/userChatRV"
                    app:layout_constraintEnd_toEndOf="@id/userChatRV">

                    <TextView
                        android:id="@+id/unread_comment_count"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_border_blue"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:textColor="@color/bottom_bar_selected_item_color"
                        android:textSize="@dimen/text_11" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_8"
                        android:rotation="90"
                        android:src="@drawable/ic_more_chat_down_white_24dp" />

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chatboxLL"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_12"
                    android:layout_marginBottom="@dimen/margin_8"
                    android:layout_weight="1"
                    android:background="@drawable/write_chat_message_box_bg"
                    android:contentDescription="@string/first_comment_reward_alert"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/margin_12"
                    android:paddingTop="@dimen/margin_8"
                    android:paddingEnd="@dimen/margin_12"
                    android:paddingBottom="@dimen/margin_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/sticker_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginRight="@dimen/margin_12"
                        android:src="@drawable/ic_sticker_icon" />

                    <TextView
                        android:id="@+id/chatbox_login_btn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Login to Chat"
                        android:textColor="#4DFBFBFB"
                        android:textSize="@dimen/text_15" />

                    <androidx.emoji.widget.EmojiEditText
                        android:id="@+id/chatbox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@null"
                        android:maxLength="200"
                        android:textColor="@color/white"
                        android:textColorHint="#4DFBFBFB"
                        android:textSize="@dimen/text_15"
                        android:visibility="gone"
                        tools:text="asdasdasdasdasdasdasdas" />

                    <ImageView
                        android:id="@+id/sendButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginLeft="@dimen/margin_12"
                        android:src="@drawable/ic_send_white_24dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/heart_anim_image_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_14"
                        android:layout_marginEnd="@dimen/margin_14"
                        android:scaleType="fitXY"
                        android:visibility="invisible"
                        app:layout_constraintBottom_toBottomOf="@id/heart_image_view"
                        app:layout_constraintLeft_toLeftOf="@id/heart_image_view"
                        app:layout_constraintRight_toRightOf="@id/heart_image_view"
                        app:layout_constraintTop_toTopOf="@id/heart_image_view"
                        app:srcCompat="@drawable/ic_like_heart_filled_48" />
                    <!--android:visibility="@{viewModel.isLive ? View.VISIBLE : View.GONE}"-->

                    <TextView
                        android:id="@+id/heart_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="@{viewModel.totalHeartCount}"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_12"
                        app:layout_constraintBottom_toBottomOf="@id/heart_image_view"
                        app:layout_constraintEnd_toEndOf="@id/heart_image_view"
                        app:layout_constraintStart_toStartOf="@id/heart_image_view"
                        tools:text="15" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/heart_image_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="@dimen/margin_9"
            android:scaleType="fitXY"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/chatboxLL"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/avd_heart_fill" />

        <FrameLayout
            android:id="@+id/heart_container"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toStartOf="parent" />

    </FrameLayout>

</layout>
