<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/camera_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#33000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/profile_image_view"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="96dp"
            app:layout_constraintBottom_toTopOf="@id/username_message_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/username_message_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_36"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_36"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textAlignment="gravity"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/profile_image_view"
            tools:text="Atiyapa" />

        <TextView
            android:id="@+id/accept_call_msg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_36"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="@dimen/margin_36"
            android:gravity="center"
            android:text="Answer to become co-host."
            android:textAlignment="gravity"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/username_message_text_view" />

        <ImageView
            android:id="@+id/deny_call_img"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="64dp"
            android:layout_marginBottom="64dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_call_end_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/accept_call_img"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="64dp"
            android:layout_marginBottom="64dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_baseline_call_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/deny_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_12"
            android:fontFamily="sans-serif-medium"
            android:text="DECLINE"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/deny_call_img"
            app:layout_constraintStart_toStartOf="@id/deny_call_img"
            app:layout_constraintTop_toBottomOf="@id/deny_call_img" />

        <TextView
            android:id="@+id/accept_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_12"
            android:fontFamily="sans-serif-medium"
            android:text="ANSWER"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/accept_call_img"
            app:layout_constraintStart_toStartOf="@id/accept_call_img"
            app:layout_constraintTop_toBottomOf="@id/accept_call_img" />

        <View
            android:id="@+id/accept_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="@id/accept_call"
            app:layout_constraintEnd_toEndOf="@id/accept_call"
            app:layout_constraintStart_toStartOf="@id/accept_call"
            app:layout_constraintTop_toTopOf="@id/accept_call_img" />

        <View
            android:id="@+id/deny_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="?selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="@id/deny_call"
            app:layout_constraintEnd_toEndOf="@id/deny_call"
            app:layout_constraintStart_toStartOf="@id/deny_call"
            app:layout_constraintTop_toTopOf="@id/deny_call_img" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>