<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="inEditMode"
            type="Boolean" />

        <variable
            name="game"
            type="com.rheotv.android.data.network.models.useProfile.responses.GameWiseUser" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_4">

        <ImageView
            android:id="@+id/game_icon_image_view"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="@dimen/margin_4"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginEnd="@dimen/margin_4"
            app:imageUrlCircular="@{game.thumbnail}"
            app:height="@{34}"
            app:width="@{34}"
            app:layout_constraintBottom_toTopOf="@id/view_divider"
            app:layout_constraintEnd_toStartOf="@id/game_name_text_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/game_name_text_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_8"
            android:layout_marginEnd="@dimen/margin_8"
            android:fontFamily="sans-serif-medium"
            android:text="@{game.name}"
            android:textColor="#fbfbfb"
            android:textSize="14sp"
            android:textStyle="normal"
            app:layout_constraintBottom_toBottomOf="@id/game_icon_image_view"
            app:layout_constraintEnd_toStartOf="@id/game_username_text_view"
            app:layout_constraintStart_toEndOf="@id/game_icon_image_view"
            app:layout_constraintTop_toTopOf="@id/game_icon_image_view"
            tools:text="@tools:sample/full_names" />

        <TextView
            android:id="@+id/game_username_text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_4"
            android:layout_marginEnd="@dimen/margin_4"
            android:fontFamily="sans-serif-medium"
            android:gravity="end"
            android:text="@{game.gameUsername}"
            android:textColor="#438cfd"
            android:textSize="14sp"
            android:textStyle="normal"
            android:visibility="@{inEditMode ? View.INVISIBLE : View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="@id/game_name_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/game_name_text_view"
            app:layout_constraintTop_toTopOf="@id/game_name_text_view"
            tools:text="@tools:sample/first_names" />

        <ImageButton
            android:id="@+id/delete_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_4"
            android:background="@null"
            app:layout_constraintBottom_toBottomOf="@id/game_name_text_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/game_name_text_view"
            app:srcCompat="@drawable/ic_delete_outline_white"
            app:visibleWhen="@{inEditMode}"
            tools:visibility="visible" />

        <View
            android:id="@+id/view_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/margin_12"
            android:background="@color/color_gray_divider"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/game_icon_image_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>