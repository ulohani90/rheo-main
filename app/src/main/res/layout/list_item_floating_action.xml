<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="menuOption"
            type="com.rheotv.android.ui.customViews.bottomSheetMenu.OptionRequest" />

        <import type="com.rheotv.android.utils.ViewUtils" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@{ViewUtils.getRectangularDrawable(menuOption.backGroundColor, ViewUtils.dpToPx(14))}"
            android:gravity="center"
            android:padding="@dimen/margin_8">

            <ImageView
                android:id="@+id/icon_image_view"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@{menuOption.drawable}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:srcCompat="@drawable/avd_clips" />

            <TextView
                android:id="@+id/menu_item_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12"
                android:layout_marginEnd="@dimen/margin_2"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_horizontal"
                android:text="@{menuOption.title}"
                android:textColor="#ffffff"
                android:textSize="15sp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon_image_view"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Upload a Clip" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>