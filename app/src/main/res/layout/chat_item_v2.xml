        <ImageView
            android:id="@+id/pin_image_view"
            android:layout_width="@dimen/size_32"
            android:layout_height="@dimen/size_32"
            android:layout_marginEnd="@dimen/margin_8"
            android:padding="@dimen/margin_4"
            android:scaleType="centerCrop"
            android:src="@drawable/avd_pin"
            android:visibility="@{isPinned ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintBottom_toBottomOf="@id/chat_user_pic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/chat_user_pic" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>