<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/vidThumbnail"
            android:layout_width="0dp"
            android:layout_height="148dp"
            android:adjustViewBounds="true"
            android:maxWidth="164dp"
            android:scaleType="centerCrop"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/title"
            app:riv_corner_radius="@dimen/corner_radius" />

        <TextView
            android:id="@+id/liveTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_4"
            android:layout_marginBottom="@dimen/margin_4"
            android:background="@drawable/button_transparent_white_border"
            android:elevation="4dp"
            android:paddingLeft="4dp"
            android:paddingTop="2dp"
            android:paddingRight="4dp"
            android:paddingBottom="2dp"
            android:text="LIVE"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_margin="@dimen/margin_4"
            app:layout_constraintStart_toStartOf="@id/vidThumbnail"
            app:layout_constraintTop_toTopOf="@id/vidThumbnail"/>

        <com.rheotv.android.ui.customViews.CircularImageView
            android:id="@+id/userProfilePic"
            android:layout_width="@dimen/margin_36"
            android:layout_height="@dimen/margin_36"
            android:layout_marginEnd="@dimen/margin_12"
            android:scaleType="centerCrop"
            app:civ_border="true"
            app:civ_border_color="@color/white"
            app:civ_border_width="@dimen/margin_1"
            android:layout_marginStart="@dimen/margin_8"
            app:layout_constraintTop_toTopOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/margin_12"
            android:layout_marginTop="@dimen/margin_8"
            android:layout_marginRight="@dimen/margin_12"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="@dimen/text_14"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/userProfilePic"
            app:layout_constraintBottom_toTopOf="@id/subtitle"
            app:layout_constraintTop_toBottomOf="@id/vidThumbnail"
            tools:text="How to kill one with gun" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/margin_6"
            android:layout_marginBottom="@dimen/margin_6"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/light_dull"
            android:textSize="@dimen/text_13"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/title"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="How to kill one with gun" />

        <TextView
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/game_tag_bg"
            android:paddingStart="@dimen/margin_4"
            android:paddingTop="@dimen/margin_2"
            android:paddingEnd="@dimen/margin_4"
            android:paddingBottom="@dimen/margin_2"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginBottom="@dimen/margin_8"
            android:layout_marginTop="@dimen/margin_2"
            app:layout_constraintStart_toStartOf="@id/subtitle"
            app:layout_constraintTop_toBottomOf="@id/subtitle"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Fortnite" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:layout_marginEnd="@dimen/margin_4"
            android:background="@drawable/round_background_black"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/margin_4"
            android:paddingTop="@dimen/margin_2"
            android:paddingEnd="@dimen/margin_4"
            android:paddingBottom="@dimen/margin_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/listing_iv_views"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="@dimen/margin_4"
                android:src="@drawable/eye_white" />

            <TextView
                android:id="@+id/viewCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                android:layout_gravity="center_vertical"
                android:textSize="12sp"
                tools:text="999" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>