<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.rheotv.android.utils.CommonUtils" />

        <variable
            name="analytics"
            type="com.rheotv.android.data.network.models.AnalyticsStreamerData" />

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/color_suggestion_chip"
        app:cardCornerRadius="@dimen/size_16">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/margin_12">

            <TextView
                android:id="@+id/view_title_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@{analytics.value}"
                android:textColor="#fbfbfb"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/view_count_text_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="234k" />

            <TextView
                android:id="@+id/view_count_text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4"
                android:fontFamily="sans-serif-medium"
                android:text="@{analytics.title}"
                android:textColor="#a8a8af"
                android:textSize="12sp"
                android:textStyle="normal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_title_text_view" />

            <!-- <com.github.mikephil.charting.charts.LineChart
                 android:id="@+id/chart_view_count"
                 android:layout_width="0dp"
                 android:layout_height="0dp"
                 android:layout_marginStart="@dimen/margin_16"
                 app:chartLabel="@{`views`}"
                 app:chatGraphObject="@{analytics.dailyViews}"
                 app:layout_constraintBottom_toBottomOf="@+id/view_count_text_view"
                 app:layout_constraintEnd_toEndOf="parent"
                 app:layout_constraintStart_toEndOf="@+id/text_barrier"
                 app:layout_constraintTop_toTopOf="@+id/view_title_text_view"
                 app:shouldFormatChatDate="@{true}"
                 app:visibleWhen="@{analytics.dailyViews != null &amp;&amp; !analytics.dailyViews.empty}" />-->

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>