<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/streamer_info_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:paddingTop="@dimen/margin_12"
    android:paddingBottom="@dimen/margin_12">

    <com.rheotv.android.ui.customViews.CircularImageView
        android:id="@+id/userProfilePic"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginEnd="@dimen/margin_12"
        android:scaleType="centerCrop"
        android:src="@drawable/avd_avatar"
        app:civ_border="true"
        app:civ_border_color="@color/white"
        app:civ_border_width="@dimen/margin_1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_2"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_toRightOf="@id/userProfilePic"
        android:orientation="vertical">

        <TextView
            android:id="@+id/user_name_tv"
            android:layout_width="120dp"
            android:layout_height="@dimen/margin_14"
            android:layout_marginBottom="@dimen/margin_8"
            android:background="@color/player_unplayed_color"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/title_text_view"
            android:layout_width="90dp"
            android:layout_height="@dimen/margin_10"
            android:layout_marginBottom="@dimen/margin_6"
            android:background="@color/player_unplayed_color"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textStyle="normal" />

    </LinearLayout>

</RelativeLayout>