<?xml version="1.0" encoding="utf-8"?>
<layout>
    <com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background_color"
        android:layout_marginLeft="@dimen/margin_20"
        android:layout_marginRight="@dimen/margin_20"
        app:shimmer_auto_start="true"
        app:shimmer_base_alpha="0.2"
        app:shimmer_highlight_alpha="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/top_streamer_title"
                android:layout_width="200dp"
                android:layout_height="@dimen/margin_12"
                android:layout_marginBottom="@dimen/margin_16"
                android:background="@color/player_unplayed_color"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <include layout="@layout/list_item_shimmer_streamer" />

            <include layout="@layout/list_item_shimmer_streamer" />

            <include layout="@layout/list_item_shimmer_streamer" />

            <TextView
                android:id="@+id/top_game_title"
                android:layout_width="160dp"
                android:layout_height="@dimen/margin_12"
                android:layout_marginTop="@dimen/margin_40"
                android:layout_marginBottom="@dimen/margin_16"
                android:background="@color/player_unplayed_color"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                android:textSize="14sp" />

            <include layout="@layout/list_item_shimmer_game" />

            <include layout="@layout/list_item_shimmer_game" />

            <include layout="@layout/list_item_shimmer_game" />

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

</layout>