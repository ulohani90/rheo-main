<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:paddingRight="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:text="Set up streaming"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/cancelButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:layout_margin="@dimen/margin_8"
                    android:src="@drawable/avd_back_white" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#e1dfdf" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_8"
                android:layout_marginBottom="@dimen/margin_8"

                android:text="@string/no_1080p_msg"
                android:textAlignment="center"
                android:textColor="@color/red"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- loader progress -->
                <LinearLayout
                    android:id="@+id/loaderRL"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <ProgressBar
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_centerHorizontal="true"
                        android:elevation="2dp"
                        android:indeterminateDrawable="@drawable/progress_dark" />

                    <TextView
                        android:id="@+id/loaderTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Getting game details..."
                        android:textSize="14sp" />
                </LinearLayout>


                <!-- game form -->
                <RelativeLayout
                    android:id="@+id/inputContainerRL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingLeft="@dimen/margin_8"
                    android:paddingRight="@dimen/margin_8"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/form_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/toolbar_share_app"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="8dp"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <!--<TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:layout_marginBottom="4dp"
                                android:layout_weight="2"
                                android:lines="1"
                                android:maxLines="1"
                                android:text="Title"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16"
                                android:textStyle="bold" />-->


                            <androidx.emoji.widget.EmojiEditText
                                android:id="@+id/gameTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/edittext_ligh_grey_bg"
                                android:hint="Enter Game Title eg. Pubg Tournament"
                                android:inputType="text"
                                android:padding="@dimen/margin_12"
                                android:textColor="@color/black"
                                android:textSize="@dimen/text_16" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:background="#e1dfdf"
                            android:orientation="horizontal">


                            <Spinner
                                android:id="@+id/gameSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginTop="4dp"
                                android:layout_marginBottom="4dp"
                                android:background="@drawable/rectangle_box_bg"
                                android:inputType="text"
                                android:overlapAnchor="false"
                                android:paddingTop="@dimen/margin_4"
                                android:paddingBottom="@dimen/margin_4"
                                android:spinnerMode="dropdown"
                                android:theme="@style/ThemeOverlay.AppCompat.Light" />
                        </LinearLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"

                            android:gravity="center_vertical">

                            <!--<TextView
                                android:id="@+id/uploadLabel"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginRight="8dp"
                                android:lines="1"
                                android:maxLines="1"
                                android:text="Thumbnail"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:textStyle="bold" />-->

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/chooseFileTV"
                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"
                                android:layout_centerHorizontal="true"

                                android:gravity="center">

                                <ImageView
                                    android:id="@+id/uploadThumbnail"
                                    android:layout_width="96dp"
                                    android:layout_height="96dp"
                                    android:layout_centerHorizontal="true"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/ic_cloud_upload_red_96dp"
                                    app:layout_constraintBottom_toTopOf="@id/upload_thumbnail_text"
                                    app:layout_constraintLeft_toLeftOf="parent"
                                    app:layout_constraintRight_toRightOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintWidth_percent="1" />

                                <TextView
                                    android:id="@+id/upload_thumbnail_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/uploadThumbnail"
                                    android:layout_centerHorizontal="true"
                                    android:layout_marginTop="@dimen/margin_4"
                                    android:background="@drawable/edittext_ligh_grey_bg"
                                    android:elevation="2dp"
                                    android:ellipsize="none"
                                    android:paddingLeft="8dp"
                                    android:paddingTop="@dimen/margin_4"
                                    android:paddingRight="8dp"
                                    android:paddingBottom="4dp"
                                    android:singleLine="true"
                                    android:text="Upload Thumbnail"
                                    android:textColor="@color/black"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/play_request_holder_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/margin_12"
                            android:visibility="gone">

                            <CheckBox
                                android:id="@+id/play_request_checkbox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/white"
                                android:textColor="@color/white" />

                            <TextView
                                android:id="@+id/play_request_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignTop="@id/play_request_checkbox"
                                android:layout_toEndOf="@id/play_request_checkbox"
                                android:text="@string/take_play_request"
                                android:textColor="@color/white" />
                        </RelativeLayout>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/margin_12">

                            <CheckBox
                                android:id="@+id/terms_checkbox"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:buttonTint="@color/white"
                                android:textColor="@color/white" />

                            <TextView
                                android:id="@+id/terms_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_alignTop="@id/terms_checkbox"
                                android:layout_toEndOf="@id/terms_checkbox"
                                android:textColor="@color/white" />
                        </RelativeLayout>

                        <TextView
                            android:id="@+id/submit_live"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/form_layout"
                            android:background="@drawable/button_rheotv_dark_round"
                            android:padding="8dp"
                            android:text="SUBMIT"
                            android:textAlignment="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_18"
                            android:textStyle="bold"
                            android:visibility="visible" />


                    </LinearLayout>

                </RelativeLayout>


                <!-- details key -->
                <RelativeLayout
                    android:id="@+id/rtmpLinkRL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/phone_img"
                        android:layout_width="300dp"
                        android:layout_height="200dp"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/phone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/phone_img"
                        android:background="@color/white"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:alpha="0.9"
                            android:gravity="center"
                            android:text="Use the below settings to start broadcasting."
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_18"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/rtmpURL"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:text="dfkd"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/copy_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:layout_marginBottom="18dp"
                            android:background="@drawable/button_rheotv_dark_round"
                            android:padding="8dp"
                            android:text="COPY URL"
                            android:textAlignment="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:visibility="visible" />

                        <TextView
                            android:id="@+id/rtmpKEY"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="KEY"
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/copy_key"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginLeft="16dp"
                            android:layout_marginRight="16dp"
                            android:background="@drawable/button_rheotv_dark_round"
                            android:padding="8dp"
                            android:text="COPY KEY"
                            android:textAlignment="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/text_14"
                            android:textStyle="bold"
                            android:visibility="visible" />
                    </LinearLayout>
                </RelativeLayout>

            </LinearLayout>


            <LinearLayout
                android:id="@+id/moreInfoView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_16"
                android:layout_marginBottom="@dimen/margin_16"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dashed_border"
                    android:text="How to Stream?"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_14" />
            </LinearLayout>

        </LinearLayout>


    </RelativeLayout>
</layout>