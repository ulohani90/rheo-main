<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/margin_12">


    <LinearLayout
        android:id="@+id/options_layout"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/head"
        android:background="@drawable/rounded_corner_bg_21"
        android:backgroundTint="@color/color_bottom_sheet_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="60dp"
        android:paddingBottom="@dimen/margin_12"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btn_view"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:elevation="@dimen/margin_4"
            android:scaleType="centerInside"
            android:src="@drawable/avd_eye_24" />

        <ImageView
            android:id="@+id/btn_mute"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/margin_12"
            android:scaleType="centerInside"
            android:src="@drawable/avd_mic_24" />

        <ImageView
            android:id="@+id/btn_exit"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/margin_12"
            android:scaleType="centerInside"
            android:src="@drawable/avd_logout_white"
            app:tint="@color/white" />

    </LinearLayout>

    <ImageView
        android:id="@+id/head"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/circle_grey_bg"
        android:backgroundTint="@color/color_accent"
        android:padding="3dp"
        android:scaleType="centerInside"
        android:src="@drawable/avd_community"
        app:tint="@color/white" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignEnd="@id/head"
        android:layout_marginTop="40dp"
        android:src="@drawable/ic_volume_up_white_24dp"
        android:visibility="visible" />

</RelativeLayout>