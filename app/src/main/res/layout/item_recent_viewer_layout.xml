<?xml version="1.0" encoding="utf-8"?>
<layout>

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.mikhaellopez.circularimageview.CircularImageView
            android:id="@+id/authorID2"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="@dimen/margin_8"
            android:elevation="6dp"
            android:visibility="visible"
            app:civ_border="true"
            app:civ_border_width="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nameL"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:background="@drawable/avd_avatar" />

        <TextView
            android:id="@+id/nameL"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_12"
            android:layout_marginEnd="@dimen/margin_8"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxEms="8"
            android:maxLines="1"

            android:textColor="#fbfbfb"
            android:textSize="@dimen/text_14"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/authorID2"
            app:layout_constraintTop_toTopOf="@id/authorID2"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Dreamleague" />

        <TextView
            android:id="@+id/follower_count_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/margin_12"
            android:layout_marginEnd="@dimen/margin_8"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxEms="8"
            android:maxLines="1"
            android:textColor="#fbfbfb"
            android:textSize="@dimen/text_13"
            app:layout_constraintBottom_toBottomOf="@id/authorID2"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/authorID2"
            app:layout_constraintTop_toBottomOf="@id/nameL"
            tools:text="144K followers" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>