<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/margin_8"
    android:paddingBottom="@dimen/margin_8">

    <View
        android:id="@+id/game_thumbnail_image_view"
        android:layout_width="76dp"
        android:layout_height="100dp"
        android:background="@drawable/button_transparent_white_border"
        android:backgroundTint="@color/player_unplayed_color"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/game_title_view"
        android:layout_width="120dp"
        android:layout_height="@dimen/margin_12"
        android:layout_marginStart="@dimen/margin_16"
        android:layout_marginTop="@dimen/margin_4"
        android:layout_marginBottom="@dimen/margin_8"
        android:background="@color/player_unplayed_color"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@id/game_thumbnail_image_view"
        app:layout_constraintTop_toTopOf="@id/game_thumbnail_image_view" />

    <View
        android:id="@+id/total_views_view"
        android:layout_width="90dp"
        android:layout_height="@dimen/margin_8"
        android:layout_marginTop="@dimen/margin_12"
        android:layout_marginEnd="@dimen/margin_12"
        android:background="@color/player_unplayed_color"
        android:padding="@dimen/margin_4"
        app:layout_constraintEnd_toEndOf="@id/game_title_view"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@id/game_title_view"
        app:layout_constraintTop_toBottomOf="@id/game_title_view" />

</androidx.constraintlayout.widget.ConstraintLayout>