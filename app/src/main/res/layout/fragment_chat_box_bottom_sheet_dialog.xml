<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.activities.player.activity.ChatBoxBottomSheetDialog">

    <data>

        <variable
            name="streamName"
            type="String" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.emoji.widget.EmojiEditText
            android:id="@+id/message_edit_text"
            style="@style/EditTextStyle.Base"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="@dimen/margin_8"
            android:layout_weight="1"
            android:background="@null"
            android:ellipsize="end"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="sans-serif"
            android:gravity="center|start"
            android:hint="@{@string/say_hi + ` ` + streamName}"
            android:padding="@dimen/margin_4"
            android:textColorHint="@color/color_edit_text_hint" />

        <ImageButton
            android:id="@+id/send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/margin_8"
            android:background="?selectableItemBackgroundBorderless"
            android:padding="@dimen/margin_6"
            android:src="@drawable/ic_send_white_24dp"
            app:layout_constraintBottom_toBottomOf="@id/message_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/message_container" />

    </LinearLayout>

</layout>