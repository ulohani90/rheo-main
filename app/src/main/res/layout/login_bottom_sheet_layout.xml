<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_sheet_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/margin_20">

            <ImageView
                android:id="@+id/close_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_close_white_28dp" />

            <ImageView
                android:id="@+id/logo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_login_white_outline_102dp" />

            <LinearLayout
                android:id="@+id/login_google_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/logo"
                android:layout_marginBottom="@dimen/margin_8"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/login_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:fontFamily="sans-serif"
                    android:gravity="center"
                    android:text="@string/login_text"
                    android:textColor="@color/white_text_color"
                    android:textSize="@dimen/text_14" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:inputType="text"
                    android:textColor="@color/white_text_color"
                    android:textSize="@dimen/text_14"
                    android:theme="@style/EditTextStyle"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/login_with_google_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:background="@drawable/white_rounded_corner_r_20dp"
                    android:drawableLeft="@drawable/ic_google_logo_18dp"
                    android:drawablePadding="@dimen/margin_12"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="@dimen/margin_14"
                    android:paddingEnd="@dimen/margin_16"
                    android:paddingTop="@dimen/margin_10"
                    android:paddingBottom="@dimen/margin_10"
                    android:text="Login with Google"
                    android:textColor="#8a000000"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:id="@+id/terms_and_conditions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_12"
                    android:gravity="center|start"
                    android:text="@string/read_terms_text"
                    android:textColor="@color/light_grey_text_color"
                    android:textSize="12sp"
                    android:layout_marginBottom="@dimen/margin_12"  />

                <TextView
                    android:id="@+id/verify_username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:background="@drawable/follow_normal_bg"
                    android:gravity="center"
                    android:padding="@dimen/margin_12"
                    android:text="Done"
                    android:textColor="@color/white_text_color"
                    android:textSize="@dimen/text_14"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/login_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_20"
                    android:indeterminateTint="@color/bottom_bar_selected_item_color"
                    android:visibility="gone" />
            </LinearLayout>

        </RelativeLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>